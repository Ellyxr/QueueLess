NODE_ENV=
PORT=
DATABASE_URL=
# Comma-separated exact origins; the Render static site needs this exact origin.
CORS_ORIGIN=http://localhost:5173,https://queueless-static.onrender.com
JWT_SECRET=
JWT_EXPIRES_IN=15m
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
MARKETPLACE_FEE_RATE=0
# Use the deployed frontend origin for public checkout redirects.
PAYMONGO_SUCCESS_URL=https://queueless-static.onrender.com/payment/success
PAYMONGO_CANCEL_URL=https://queueless-static.onrender.com/payment/cancel
# Pasabuy fees are authoritative fixed tiers: PHP 30 in campus, PHP 50 outside campus.
# Set to minLatitude,minLongitude,maxLatitude,maxLongitude for the campus boundary.
PASABUY_CAMPUS_BOUNDS=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String                  @unique
  passwordHash             String
  fullName                 String
  phone                    String?
  isActive                 Boolean                 @default(true)
  studentEmailVerifiedAt   DateTime?               @db.Timestamptz(6)
  createdAt                DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(6)
  auditRecords             AuditRecord[]           @relation("AuditActor")
  carts                    Cart[]
  eventsCreated            Event[]                 @relation("EventCreatedBy")
  groupOrderParticipations GroupOrderParticipant[]
  groupOrdersInitiated     GroupOrder[]            @relation("GroupOrderInitiator")
  notifications            Notification[]
  orderIdempotencyKeys     OrderIdempotencyKey[]
  orderStatusChanges       OrderStatusHistory[]    @relation("OrderStatusChangedBy")
  ordersPlaced             Order[]                 @relation("OrderCustomer")
  pasabuyRequestsFulfilled PasabuyRequest[]        @relation("PasabuyFulfiller")
  pasabuyRequestsMade      PasabuyRequest[]        @relation("PasabuyRequester")
  pasabuyStatusChanges     PasabuyStatusHistory[]  @relation("PasabuyStatusChangedBy")
  paymentShares            PaymentShare[]          @relation("PaymentSharePayer")
  payments                 Payment[]               @relation("PaymentPayer")
  refreshTokens            RefreshToken[]
  refundsRequested         Refund[]                @relation("RefundRequestedBy")
  reportStatusChangesMade  ReportStatusHistory[]   @relation("ReportStatusAdmin")
  reportsTargetingMe       Report[]                @relation("ReportTargetUser")
  reportsSubmitted         Report[]                @relation("ReportReporter")
  roleAssignments          RoleAssignment[]
  vendorOwned              Vendor?                 @relation("VendorOwner")

  @@map("users")
}

model RoleAssignment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  role      UserRole
  grantedAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("role_assignments")
}

model EmailVerificationCode {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  codeHash   String
  purpose    EmailVerificationPurpose @default(SIGNUP)
  expiresAt  DateTime                 @db.Timestamptz(6)
  consumedAt DateTime?                @db.Timestamptz(6)
  attempts   Int                      @default(0)
  createdAt  DateTime                 @default(now()) @db.Timestamptz(6)

  @@index([email])
  @@map("email_verification_codes")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  replacedByTokenId String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Vendor {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId         String                     @unique @db.Uuid
  name                String
  description         String?
  campusLocation      String?
  vendorType          VendorType
  status              VendorStatus               @default(ACTIVE)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(6)
  businessName        String?
  carts               Cart[]
  eventParticipations EventVendorParticipation[]
  featuredListings    FeaturedListing[]
  groupOrders         GroupOrder[]
  orders              Order[]
  products            Product[]
  reportsTargeting    Report[]                   @relation("ReportTargetVendor")
  subscriptions       VendorSubscription[]
  owner               User                       @relation("VendorOwner", fields: [ownerUserId], references: [id])

  @@index([ownerUserId])
  @@index([status])
  @@map("vendors")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId         String            @db.Uuid
  name             String
  description      String?
  price            Decimal           @db.Decimal(10, 2)
  category         String?
  isAvailable      Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  cartItems        CartItem[]
  featuredListings FeaturedListing[]
  orderItems       OrderItem[]
  vendor           Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reportsTargeting Report[]          @relation("ReportTargetProduct")

  @@unique([vendorId, name])
  @@index([vendorId])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "products_name_trgm_idx", type: Gin)
  @@index([vendorId, isAvailable])
  @@map("products")
}

model Organization {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String?
  contactEmail String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  events       Event[]

  @@map("organizations")
}

model Event {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String?                    @db.Uuid
  createdByUserId      String?                    @db.Uuid
  name                 String
  description          String?
  location             String?
  startAt              DateTime                   @db.Timestamptz(6)
  endAt                DateTime                   @db.Timestamptz(6)
  status               EventStatus                @default(DRAFT)
  bannerImageUrl       String?
  createdAt            DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(6)
  vendorParticipations EventVendorParticipation[]
  createdBy            User?                      @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  organization         Organization?              @relation(fields: [organizationId], references: [id])
  orders               Order[]

  @@index([organizationId])
  @@index([status])
  @@map("events")
}

model EventVendorParticipation {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId  String            @db.Uuid
  vendorId String            @db.Uuid
  status   EventVendorStatus @default(INVITED)
  joinedAt DateTime?         @db.Timestamptz(6)
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor   Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([eventId])
  @@index([vendorId])
  @@map("event_vendor_participations")
}

model Cart {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @db.Uuid
  vendorId  String     @db.Uuid
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vendorId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @db.Timestamptz(6)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String                @db.Uuid
  vendorId         String                @db.Uuid
  eventId          String?               @db.Uuid
  groupOrderId     String?               @unique @db.Uuid
  orderType        OrderType
  status           OrderStatus           @default(PENDING)
  subtotal         Decimal               @db.Decimal(10, 2)
  marketplaceFee   Decimal               @db.Decimal(10, 2)
  totalAmount      Decimal               @db.Decimal(10, 2)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(6)
  idempotencyKeys  OrderIdempotencyKey[]
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  customer         User                  @relation("OrderCustomer", fields: [customerId], references: [id])
  event            Event?                @relation(fields: [eventId], references: [id])
  groupOrder       GroupOrder?           @relation(fields: [groupOrderId], references: [id])
  vendor           Vendor                @relation(fields: [vendorId], references: [id])
  pasabuyRequests  PasabuyRequest[]
  paymentShares    PaymentShare[]
  reportsTargeting Report[]              @relation("ReportTargetOrder")

  @@index([customerId])
  @@index([vendorId])
  @@index([eventId])
  @@index([status])
  @@map("orders")
}

model OrderIdempotencyKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  key       String
  cartId    String   @db.Uuid
  eventId   String?  @db.Uuid
  orderId   String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([orderId])
  @@map("order_idempotency_keys")
}

model OrderItem {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String                 @db.Uuid
  productId         String                 @db.Uuid
  participantId     String?                @db.Uuid
  quantity          Int
  unitPriceSnapshot Decimal                @db.Decimal(10, 2)
  lineSubtotal      Decimal                @db.Decimal(10, 2)
  removedAt         DateTime?              @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  participant       GroupOrderParticipant? @relation(fields: [participantId], references: [id])
  product           Product                @relation(fields: [productId], references: [id])
  refunds           Refund[]

  @@index([orderId])
  @@index([productId])
  @@index([participantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String      @db.Uuid
  status          OrderStatus
  changedByUserId String?     @db.Uuid
  note            String?
  changedAt       DateTime    @default(now()) @db.Timestamptz(6)
  changedByUser   User?       @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id])
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model GroupOrder {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  initiatorUserId String                  @db.Uuid
  vendorId        String                  @db.Uuid
  status          GroupOrderStatus        @default(OPEN)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  participants    GroupOrderParticipant[]
  initiator       User                    @relation("GroupOrderInitiator", fields: [initiatorUserId], references: [id])
  vendor          Vendor                  @relation(fields: [vendorId], references: [id])
  order           Order?

  @@index([initiatorUserId])
  @@index([vendorId])
  @@map("group_orders")
}

model GroupOrderParticipant {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupOrderId String                      @db.Uuid
  userId       String                      @db.Uuid
  status       GroupOrderParticipantStatus @default(INVITED)
  joinedAt     DateTime?                   @db.Timestamptz(6)
  groupOrder   GroupOrder                  @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@unique([groupOrderId, userId])
  @@index([groupOrderId])
  @@map("group_order_participants")
}

model PaymentShare {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String             @db.Uuid
  payerUserId String             @db.Uuid
  amountDue   Decimal            @db.Decimal(10, 2)
  status      PaymentShareStatus @default(PENDING)
  paymentId   String?            @db.Uuid
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payer       User               @relation("PaymentSharePayer", fields: [payerUserId], references: [id])
  payment     Payment?           @relation(fields: [paymentId], references: [id])

  @@unique([orderId, payerUserId])
  @@index([orderId])
  @@index([paymentId])
  @@map("payment_shares")
}

model Payment {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payerUserId          String              @db.Uuid
  purpose              PaymentPurpose
  pasabuyRequestId     String?             @db.Uuid
  vendorSubscriptionId String?             @db.Uuid
  featuredListingId    String?             @db.Uuid
  amount               Decimal             @db.Decimal(10, 2)
  currency             String              @default("PHP")
  provider             PaymentProvider     @default(PAYMONGO)
  providerPaymentId    String?
  status               PaymentStatus       @default(PENDING)
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  paymentShares        PaymentShare[]
  featuredListing      FeaturedListing?    @relation(fields: [featuredListingId], references: [id], onDelete: Restrict)
  pasabuyRequest       PasabuyRequest?     @relation(fields: [pasabuyRequestId], references: [id], onDelete: Restrict)
  payer                User                @relation("PaymentPayer", fields: [payerUserId], references: [id])
  vendorSubscription   VendorSubscription? @relation(fields: [vendorSubscriptionId], references: [id], onDelete: Restrict)
  refunds              Refund[]

  @@index([payerUserId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("payments")
}

model Refund {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String       @db.Uuid
  orderItemId       String?      @db.Uuid
  amount            Decimal      @db.Decimal(10, 2)
  reason            String?
  status            RefundStatus @default(REQUESTED)
  requestedByUserId String       @db.Uuid
  providerRefundId  String?
  processedAt       DateTime?    @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  orderItem         OrderItem?   @relation(fields: [orderItemId], references: [id])
  payment           Payment      @relation(fields: [paymentId], references: [id])
  requestedBy       User         @relation("RefundRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([paymentId])
  @@index([orderItemId])
  @@map("refunds")
}

model PasabuyRequest {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterUserId  String                 @db.Uuid
  fulfillerUserId  String?                @db.Uuid
  relatedOrderId   String?                @db.Uuid
  status           PasabuyStatus          @default(PENDING)
  pickupLocation   String?
  dropoffLocation  String?
  itemDescription  String
  convenienceFee   Decimal                @db.Decimal(10, 2)
  totalAmount      Decimal                @db.Decimal(10, 2)
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(6)
  fulfiller        User?                  @relation("PasabuyFulfiller", fields: [fulfillerUserId], references: [id])
  relatedOrder     Order?                 @relation(fields: [relatedOrderId], references: [id])
  requester        User                   @relation("PasabuyRequester", fields: [requesterUserId], references: [id])
  statusHistory    PasabuyStatusHistory[]
  payments         Payment[]
  reportsTargeting Report[]               @relation("ReportTargetPasabuy")

  @@index([requesterUserId])
  @@index([fulfillerUserId])
  @@index([status])
  @@map("pasabuy_requests")
}

model PasabuyStatusHistory {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pasabuyRequestId String         @db.Uuid
  status           PasabuyStatus
  changedByUserId  String?        @db.Uuid
  note             String?
  changedAt        DateTime       @default(now()) @db.Timestamptz(6)
  changedByUser    User?          @relation("PasabuyStatusChangedBy", fields: [changedByUserId], references: [id])
  pasabuyRequest   PasabuyRequest @relation(fields: [pasabuyRequestId], references: [id], onDelete: Cascade)

  @@index([pasabuyRequestId])
  @@map("pasabuy_status_history")
}

model Report {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterUserId    String                @db.Uuid
  category          String
  description       String
  status            ReportStatus          @default(OPEN)
  reportedUserId    String?               @db.Uuid
  reportedVendorId  String?               @db.Uuid
  reportedProductId String?               @db.Uuid
  reportedOrderId   String?               @db.Uuid
  reportedPasabuyId String?               @db.Uuid
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)
  statusHistory     ReportStatusHistory[]
  reportedOrder     Order?                @relation("ReportTargetOrder", fields: [reportedOrderId], references: [id])
  reportedPasabuy   PasabuyRequest?       @relation("ReportTargetPasabuy", fields: [reportedPasabuyId], references: [id])
  reportedProduct   Product?              @relation("ReportTargetProduct", fields: [reportedProductId], references: [id])
  reportedUser      User?                 @relation("ReportTargetUser", fields: [reportedUserId], references: [id])
  reportedVendor    Vendor?               @relation("ReportTargetVendor", fields: [reportedVendorId], references: [id])
  reporter          User                  @relation("ReportReporter", fields: [reporterUserId], references: [id])

  @@index([reporterUserId])
  @@index([status])
  @@map("reports")
}

model ReportStatusHistory {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String       @db.Uuid
  status      ReportStatus
  adminUserId String       @db.Uuid
  note        String?
  changedAt   DateTime     @default(now()) @db.Timestamptz(6)
  admin       User         @relation("ReportStatusAdmin", fields: [adminUserId], references: [id])
  report      Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_status_history")
}

model SubscriptionPlan {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @unique
  price               Decimal              @db.Decimal(10, 2)
  durationDays        Int
  benefitsDescription String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  vendorSubscriptions VendorSubscription[]

  @@map("subscription_plans")
}

model VendorSubscription {
  id        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String                   @db.Uuid
  planId    String                   @db.Uuid
  status    VendorSubscriptionStatus @default(ACTIVE)
  startDate DateTime                 @db.Timestamptz(6)
  endDate   DateTime                 @db.Timestamptz(6)
  createdAt DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                 @updatedAt @db.Timestamptz(6)
  payments  Payment[]
  plan      SubscriptionPlan         @relation(fields: [planId], references: [id])
  vendor    Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
  @@map("vendor_subscriptions")
}

model FeaturedListing {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String                @db.Uuid
  productId String?               @db.Uuid
  startDate DateTime              @db.Timestamptz(6)
  endDate   DateTime              @db.Timestamptz(6)
  pricePaid Decimal               @db.Decimal(10, 2)
  status    FeaturedListingStatus @default(ACTIVE)
  createdAt DateTime              @default(now()) @db.Timestamptz(6)
  product   Product?              @relation(fields: [productId], references: [id])
  vendor    Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([vendorId])
  @@index([productId])
  @@map("featured_listings")
}

model Notification {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @db.Uuid
  type              String
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model AuditRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  actionType  String
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_records")
}

enum UserRole {
  BUYER
  VENDOR_OWNER
  ADMIN
}

enum VendorType {
  SAMPALOC_LANE
  STUDENT
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum OrderType {
  INDIVIDUAL
  GROUP
}

enum OrderStatus {
  PENDING
  PAID
  COOKING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum GroupOrderStatus {
  OPEN
  LOCKED
  FINALIZED
  CANCELLED
}

enum GroupOrderParticipantStatus {
  INVITED
  JOINED
  LEFT
}

enum PaymentShareStatus {
  PENDING
  PAID
}

enum PaymentPurpose {
  ORDER_SHARE
  PASABUY
  SUBSCRIPTION
  FEATURED_LISTING
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentProvider {
  PAYMONGO
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  DENIED
}

enum PasabuyStatus {
  PENDING
  ACCEPTED
  PAID
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum VendorSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum FeaturedListingStatus {
  ACTIVE
  EXPIRED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventVendorStatus {
  INVITED
  CONFIRMED
  DECLINED
  REMOVED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum EmailVerificationPurpose {
  SIGNUP
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  wallet Wallet?
  id                              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                           String                  @unique
  passwordHash                    String
  fullName                        String                  @unique
  phone                           String?
  isActive                        Boolean                 @default(true)
  archivedAt                      DateTime?               @db.Timestamptz(6)
  dataAccessGrantedAt             DateTime?               @db.Timestamptz(6)
  allowParticipantOrderCompletion Boolean                 @default(false)
  studentEmailVerifiedAt          DateTime?               @db.Timestamptz(6)
  createdAt                       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime                @updatedAt @db.Timestamptz(6)
  auditRecords                    AuditRecord[]           @relation("AuditActor")
  carts                           Cart[]
  eventsCreated                   Event[]                 @relation("EventCreatedBy")
  groupOrderParticipations        GroupOrderParticipant[]
  groupOrdersInitiated            GroupOrder[]            @relation("GroupOrderInitiator")
  notifications                   Notification[]
  orderIdempotencyKeys            OrderIdempotencyKey[]
  paymentIdempotencyKeys          PaymentIdempotencyKey[]
  orderStatusChanges              OrderStatusHistory[]    @relation("OrderStatusChangedBy")
  ordersPlaced                    Order[]                 @relation("OrderCustomer")
  pasabuyRequestsFulfilled        PasabuyRequest[]        @relation("PasabuyFulfiller")
  pasabuyRequestsMade             PasabuyRequest[]        @relation("PasabuyRequester")
  pasabuyStatusChanges            PasabuyStatusHistory[]  @relation("PasabuyStatusChangedBy")
  paymentShares                   PaymentShare[]          @relation("PaymentSharePayer")
  payments                        Payment[]               @relation("PaymentPayer")
  refreshTokens                   RefreshToken[]
  refundsRequested                Refund[]                @relation("RefundRequestedBy")
  reportStatusChangesMade         ReportStatusHistory[]   @relation("ReportStatusAdmin")
  reportsTargetingMe              Report[]                @relation("ReportTargetUser")
  reportsSubmitted                Report[]                @relation("ReportReporter")
  roleAssignments                 RoleAssignment[]
  vendorOwned                     Vendor?                 @relation("VendorOwner")
  favoriteVendors                 VendorFavorite[]        @relation("UserFavoriteVendors")
  pasabuyProfile                  PasabuyProfile?

  @@map("users")
}

model PasabuyProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @db.Uuid
  studentId         String    @unique
  studentIdPhotoUrl String?
  verifiedAt        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pasabuy_profiles")
}

model RoleAssignment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  role      UserRole
  grantedAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("role_assignments")
}

model EmailVerificationCode {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  codeHash   String
  purpose    EmailVerificationPurpose @default(SIGNUP)
  expiresAt  DateTime                 @db.Timestamptz(6)
  consumedAt DateTime?                @db.Timestamptz(6)
  attempts   Int                      @default(0)
  createdAt  DateTime                 @default(now()) @db.Timestamptz(6)

  @@index([email])
  @@map("email_verification_codes")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  replacedByTokenId String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Vendor {
  id                       String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId              String                       @unique @db.Uuid
  name                     String
  description              String?
  campusLocation           String?
  pickupLocation           String?
  pickupLatitude           Float?
  pickupLongitude          Float?
  categoryOrder            String[]                     @default([])
  vendorType               VendorType
  status                   VendorStatus                 @default(ACTIVE)
  createdAt                DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                     @updatedAt @db.Timestamptz(6)
  businessName             String?
  preorderEnabled          Boolean                      @default(false)
  preorderSameAsStoreHours Boolean                      @default(true)
  carts                    Cart[]
  deals                    Deal[]
  eventParticipations      EventVendorParticipation[]
  featuredListings         FeaturedListing[]
  groupOrders              GroupOrder[]
  orders                   Order[]
  products                 Product[]
  qrCodes                  VendorQrCode[]
  reportsTargeting         Report[]                     @relation("ReportTargetVendor")
  subscriptions            VendorSubscription[]
  owner                    User                         @relation("VendorOwner", fields: [ownerUserId], references: [id])
  favoritedBy              VendorFavorite[]             @relation("VendorFavoritedBy")
  ledgerEntries            VendorLedgerEntry[]
  payouts                  Payout[]
  preorderAvailability     VendorPreorderAvailability[]
  availability             VendorAvailability[]

  @@index([ownerUserId])
  @@index([status])
  @@map("vendors")
}

model VendorPreorderAvailability {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String   @db.Uuid
  dayOfWeek Weekday
  isEnabled Boolean  @default(false)
  /// 24-hour "HH:mm" local time; null while the day is disabled.
  openTime  String?  @db.VarChar(5)
  /// 24-hour "HH:mm" local time; null while the day is disabled.
  closeTime String?  @db.VarChar(5)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, dayOfWeek])
  @@index([vendorId])
  @@map("vendor_preorder_availability")
}

model VendorAvailability {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String   @db.Uuid
  dayOfWeek Weekday
  isOpen    Boolean  @default(false)
  /// 24-hour "HH:mm" local time; null while the day is closed.
  openTime  String?  @db.VarChar(5)
  /// 24-hour "HH:mm" local time; null while the day is closed.
  closeTime String?  @db.VarChar(5)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, dayOfWeek])
  @@index([vendorId])
  @@map("vendor_availability")
}

model VendorFavorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  vendorId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user   User   @relation("UserFavoriteVendors", fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation("VendorFavoritedBy", fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@index([vendorId])
  @@map("vendor_favorites")
}

model VendorQrCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String    @db.Uuid
  token     String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([isActive])
  @@map("vendor_qr_codes")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId               String            @db.Uuid
  name                   String
  description            String?
  price                  Decimal           @db.Decimal(10, 2)
  preparationTimeMinutes Int               @default(15)
  category               String?
  isAvailable            Boolean           @default(true)
  imageUrl               String?
  imageFileId            String?
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)
  cartItems              CartItem[]
  deals                  Deal[]
  featuredListings       FeaturedListing[]
  orderItems             OrderItem[]
  vendor                 Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reportsTargeting       Report[]          @relation("ReportTargetProduct")
  // Self-relation: which "extra" products (e.g. add-ons like "Extra calamansi")
  // are eligible for this product, and the inverse — which products this
  // extra is eligible for.
  eligibleExtras         Product[]         @relation("ProductEligibleExtras")
  eligibleExtraFor       Product[]         @relation("ProductEligibleExtras")

  @@unique([vendorId, name])
  @@index([vendorId])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "products_name_trgm_idx", type: Gin)
  @@index([vendorId, isAvailable])
  @@map("products")
}

model Organization {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String?
  contactEmail String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  events       Event[]

  @@map("organizations")
}

model Event {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String?                    @db.Uuid
  createdByUserId      String?                    @db.Uuid
  name                 String
  description          String?
  location             String?
  startAt              DateTime                   @db.Timestamptz(6)
  endAt                DateTime                   @db.Timestamptz(6)
  status               EventStatus                @default(DRAFT)
  bannerImageUrl       String?
  createdAt            DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(6)
  vendorParticipations EventVendorParticipation[]
  createdBy            User?                      @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  organization         Organization?              @relation(fields: [organizationId], references: [id])
  orders               Order[]

  @@index([organizationId])
  @@index([status])
  @@map("events")
}

model EventVendorParticipation {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId  String            @db.Uuid
  vendorId String            @db.Uuid
  status   EventVendorStatus @default(INVITED)
  joinedAt DateTime?         @db.Timestamptz(6)
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor   Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([eventId])
  @@index([vendorId])
  @@map("event_vendor_participations")
}

model Cart {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @db.Uuid
  vendorId     String     @db.Uuid
  groupOrderId String?    @db.Uuid
  status       CartStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)

  items      CartItem[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  groupOrder GroupOrder? @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  order      Order?      @relation(fields: [orderId], references: [id])
  orderId    String?     @db.Uuid

  @@unique([groupOrderId, userId])
  @@index([userId])
  @@index([vendorId])
  @@index([groupOrderId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @db.Timestamptz(6)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId         String                @db.Uuid
  vendorId           String                @db.Uuid
  eventId            String?               @db.Uuid
  groupOrderId       String?               @unique @db.Uuid
  orderType          OrderType
  status             OrderStatus           @default(PENDING)
  isPasabuyRequest   Boolean               @default(false)
  isPreorder         Boolean               @default(false)
  cancellationReason CancellationReason?
  cancellationNote   String?
  subtotal           Decimal               @db.Decimal(10, 2)
  marketplaceFee     Decimal               @db.Decimal(10, 2)
  totalAmount        Decimal               @db.Decimal(10, 2)
  estimatedReadyAt   DateTime?             @db.Timestamptz(6)
  pickupConfirmedAt  DateTime?             @db.Timestamptz(6)
  paidAt             DateTime?             @db.Timestamptz(6)
  buyerContactPingAt DateTime?             @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  idempotencyKeys    OrderIdempotencyKey[]
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  carts              Cart[]
  customer           User                  @relation("OrderCustomer", fields: [customerId], references: [id])
  event              Event?                @relation(fields: [eventId], references: [id])
  groupOrder         GroupOrder?           @relation(fields: [groupOrderId], references: [id])
  vendor             Vendor                @relation(fields: [vendorId], references: [id])
  pasabuyRequests    PasabuyRequest[]
  feeAssessments     FeeAssessment[]
  paymentShares      PaymentShare[]
  reportsTargeting   Report[]              @relation("ReportTargetOrder")
  ledgerEntry        VendorLedgerEntry?
  refunds            Refund[]

  @@index([customerId])
  @@index([vendorId])
  @@index([eventId])
  @@index([status])
  @@index([vendorId, status])
  @@map("orders")
}

model OrderIdempotencyKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  key       String
  cartId    String   @db.Uuid
  eventId   String?  @db.Uuid
  orderId   String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([orderId])
  @@map("order_idempotency_keys")
}

model PaymentIdempotencyKey {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @db.Uuid
  key               String
  paymentShareId    String   @db.Uuid
  paymentId         String?  @db.Uuid
  checkoutSessionId String?
  checkoutUrl       String?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentShare PaymentShare @relation(fields: [paymentShareId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@unique([userId, key])
  @@index([paymentShareId])
  @@index([paymentId])
  @@map("payment_idempotency_keys")
}

model OrderItem {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String                 @db.Uuid
  productId         String                 @db.Uuid
  participantId     String?                @db.Uuid
  quantity          Int
  unitPriceSnapshot Decimal                @db.Decimal(10, 2)
  lineSubtotal      Decimal                @db.Decimal(10, 2)
  removedAt         DateTime?              @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  participant       GroupOrderParticipant? @relation(fields: [participantId], references: [id])
  product           Product                @relation(fields: [productId], references: [id])
  refunds           Refund[]

  @@index([orderId])
  @@index([productId])
  @@index([participantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String      @db.Uuid
  status          OrderStatus
  changedByUserId String?     @db.Uuid
  note            String?
  changedAt       DateTime    @default(now()) @db.Timestamptz(6)
  changedByUser   User?       @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id])
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model GroupOrder {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  initiatorUserId  String                 @db.Uuid
  vendorId         String?                @db.Uuid
  code             String                 @unique @db.VarChar(8)
  status           GroupOrderStatus       @default(OPEN)
  paymentSplitMode GroupPaymentSplitMode?
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(6)

  participants GroupOrderParticipant[]
  initiator    User                    @relation("GroupOrderInitiator", fields: [initiatorUserId], references: [id])
  vendor       Vendor?                 @relation(fields: [vendorId], references: [id])
  order        Order?
  carts        Cart[]

  @@index([initiatorUserId])
  @@index([vendorId])
  @@map("group_orders")
}

model GroupOrderParticipant {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupOrderId String                      @db.Uuid
  userId       String                      @db.Uuid
  status       GroupOrderParticipantStatus @default(INVITED)
  joinedAt     DateTime?                   @db.Timestamptz(6)
  groupOrder   GroupOrder                  @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@unique([groupOrderId, userId])
  @@index([groupOrderId])
  @@map("group_order_participants")
}

model PaymentShare {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String                  @db.Uuid
  payerUserId     String                  @db.Uuid
  amountDue       Decimal                 @db.Decimal(10, 2)
  status          PaymentShareStatus      @default(PENDING)
  paymentId       String?                 @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payer           User                    @relation("PaymentSharePayer", fields: [payerUserId], references: [id])
  payment         Payment?                @relation(fields: [paymentId], references: [id])
  idempotencyKeys PaymentIdempotencyKey[]

  @@unique([orderId, payerUserId])
  @@index([orderId])
  @@index([paymentId])
  @@map("payment_shares")
}

model Payment {
  walletKey String?
  walletEntry WalletEntry?
  id                        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payerUserId               String                  @db.Uuid
  purpose                   PaymentPurpose
  pasabuyRequestId          String?                 @unique @db.Uuid
  vendorSubscriptionId      String?                 @db.Uuid
  featuredListingId         String?                 @db.Uuid
  amount                    Decimal                 @db.Decimal(10, 2)
  currency                  String                  @default("PHP")
  provider                  PaymentProvider         @default(PAYMONGO)
  providerPaymentId         String?
  checkoutUrl               String?
  providerPaymentResourceId String?
  status                    PaymentStatus           @default(PENDING)
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(6)
  paymentShares             PaymentShare[]
  featuredListing           FeaturedListing?        @relation(fields: [featuredListingId], references: [id], onDelete: Restrict)
  pasabuyRequest            PasabuyRequest?         @relation(fields: [pasabuyRequestId], references: [id], onDelete: Restrict)
  payer                     User                    @relation("PaymentPayer", fields: [payerUserId], references: [id])
  vendorSubscription        VendorSubscription?     @relation(fields: [vendorSubscriptionId], references: [id], onDelete: Restrict)
  refunds                   Refund[]
  reportsTargeting          Report[]                @relation("ReportTargetPayment")
  idempotencyKeys           PaymentIdempotencyKey[]

  @@unique([payerUserId, walletKey])
  @@index([payerUserId])
  @@index([status])
  @@index([providerPaymentId])
  @@index([providerPaymentResourceId])
  @@map("payments")
}

model Refund {
  walletEntry WalletEntry?
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String          @db.Uuid
  orderId           String?         @db.Uuid
  orderItemId       String?         @db.Uuid
  amount            Decimal         @db.Decimal(10, 2)
  reason            String?
  category          String?
  status            RefundStatus    @default(REQUESTED)
  initiatedBy       RefundInitiator @default(BUYER)
  requestedByUserId String          @db.Uuid
  providerRefundId  String?
  processedAt       DateTime?       @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  order             Order?          @relation(fields: [orderId], references: [id])
  orderItem         OrderItem?      @relation(fields: [orderItemId], references: [id])
  payment           Payment         @relation(fields: [paymentId], references: [id])
  requestedBy       User            @relation("RefundRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([paymentId])
  @@index([orderId])
  @@index([orderItemId])
  @@map("refunds")
}

model VendorLedgerEntry {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String          @db.Uuid
  orderId   String?         @unique @db.Uuid
  payoutId  String?         @db.Uuid
  type      LedgerEntryType
  amount    Decimal         @db.Decimal(10, 2)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  order     Order?          @relation(fields: [orderId], references: [id])
  payout    Payout?         @relation(fields: [payoutId], references: [id])

  @@index([vendorId])
  @@index([vendorId, createdAt])
  @@map("vendor_ledger_entries")
}

model Payout {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId       String              @db.Uuid
  amount         Decimal             @db.Decimal(10, 2)
  status         PayoutStatus        @default(PAYOUT_COMPLETED)
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  entries        VendorLedgerEntry[]

  @@index([vendorId])
  @@map("payouts")
}

model PasabuyRequest {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterUserId            String                 @db.Uuid
  fulfillerUserId            String?                @db.Uuid
  relatedOrderId             String?                @db.Uuid
  status                     PasabuyStatus          @default(PENDING)
  pickupLocation             String?
  dropoffLocation            String?
  itemDescription            String
  convenienceFee             Decimal                @db.Decimal(10, 2)
  feeTier                    PasabuyFeeTier?
  deliveryDistanceMeters     Int?
  dropoffLatitude            Float?
  dropoffLongitude           Float?
  totalAmount                Decimal                @db.Decimal(10, 2)
  acceptedAt                 DateTime?              @db.Timestamptz(6)
  pickupCode                 String?
  pickupVerifiedAt           DateTime?              @db.Timestamptz(6)
  pickupVerificationAttempts Int                    @default(0)
  expiresAt                  DateTime?              @db.Timestamptz(6)
  paymentStatus              PasabuyPaymentStatus   @default(NOT_CHARGED)
  paymentDeadline            DateTime?              @db.Timestamptz(6)
  termsAcceptedAt            DateTime?              @db.Timestamptz(6)
  pickedUpAt                 DateTime?              @db.Timestamptz(6)
  deliveredAt                DateTime?              @db.Timestamptz(6)
  cancelledAt                DateTime?              @db.Timestamptz(6)
  createdAt                  DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime               @updatedAt @db.Timestamptz(6)
  fulfiller                  User?                  @relation("PasabuyFulfiller", fields: [fulfillerUserId], references: [id])
  relatedOrder               Order?                 @relation(fields: [relatedOrderId], references: [id])
  requester                  User                   @relation("PasabuyRequester", fields: [requesterUserId], references: [id])
  statusHistory              PasabuyStatusHistory[]
  payment                    Payment?
  feeAssessments             FeeAssessment[]
  reportsTargeting           Report[]               @relation("ReportTargetPasabuy")

  @@index([requesterUserId])
  @@index([fulfillerUserId])
  @@index([status])
  @@map("pasabuy_requests")
}

model PasabuyStatusHistory {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pasabuyRequestId String         @db.Uuid
  status           PasabuyStatus
  changedByUserId  String?        @db.Uuid
  note             String?
  changedAt        DateTime       @default(now()) @db.Timestamptz(6)
  changedByUser    User?          @relation("PasabuyStatusChangedBy", fields: [changedByUserId], references: [id])
  pasabuyRequest   PasabuyRequest @relation(fields: [pasabuyRequestId], references: [id], onDelete: Cascade)

  @@index([pasabuyRequestId])
  @@map("pasabuy_status_history")
}

model FeeAssessment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             FeeAssessmentType
  orderId          String?           @unique @db.Uuid
  pasabuyRequestId String?           @unique @db.Uuid
  basisAmount      Decimal?          @db.Decimal(10, 2)
  ratePercent      Decimal?          @db.Decimal(10, 6)
  amount           Decimal           @db.Decimal(10, 2)
  feeTier          PasabuyFeeTier?
  distanceMeters   Int?
  ruleVersion      String
  assessedAt       DateTime          @default(now()) @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pasabuyRequest   PasabuyRequest?   @relation(fields: [pasabuyRequestId], references: [id], onDelete: Restrict)

  @@index([type, assessedAt])
  @@map("fee_assessments")
}

model Report {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterUserId     String                @db.Uuid
  targetType         String?               @db.VarChar(20)
  category           String
  description        String
  attachmentPath     String?
  attachmentFileId   String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  status             ReportStatus          @default(OPEN)
  reportedUserId     String?               @db.Uuid
  reportedVendorId   String?               @db.Uuid
  reportedProductId  String?               @db.Uuid
  reportedOrderId    String?               @db.Uuid
  reportedPasabuyId  String?               @db.Uuid
  reportedPaymentId  String?               @db.Uuid
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  statusHistory      ReportStatusHistory[]
  reportedOrder      Order?                @relation("ReportTargetOrder", fields: [reportedOrderId], references: [id])
  reportedPasabuy    PasabuyRequest?       @relation("ReportTargetPasabuy", fields: [reportedPasabuyId], references: [id])
  reportedPayment    Payment?              @relation("ReportTargetPayment", fields: [reportedPaymentId], references: [id])
  reportedProduct    Product?              @relation("ReportTargetProduct", fields: [reportedProductId], references: [id])
  reportedUser       User?                 @relation("ReportTargetUser", fields: [reportedUserId], references: [id])
  reportedVendor     Vendor?               @relation("ReportTargetVendor", fields: [reportedVendorId], references: [id])
  reporter           User                  @relation("ReportReporter", fields: [reporterUserId], references: [id])

  @@index([reporterUserId])
  @@index([status])
  @@index([reportedPaymentId])
  @@map("reports")
}

model ReportStatusHistory {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String       @db.Uuid
  status      ReportStatus
  adminUserId String       @db.Uuid
  note        String?
  changedAt   DateTime     @default(now()) @db.Timestamptz(6)
  admin       User         @relation("ReportStatusAdmin", fields: [adminUserId], references: [id])
  report      Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_status_history")
}

model SubscriptionPlan {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @unique
  price               Decimal              @db.Decimal(10, 2)
  durationDays        Int
  benefitsDescription String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  vendorSubscriptions VendorSubscription[]

  @@map("subscription_plans")
}

model VendorSubscription {
  id        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String                   @db.Uuid
  planId    String                   @db.Uuid
  status    VendorSubscriptionStatus @default(PENDING)
  startDate DateTime?                @db.Timestamptz(6)
  endDate   DateTime?                @db.Timestamptz(6)
  createdAt DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                 @updatedAt @db.Timestamptz(6)
  payments  Payment[]
  plan      SubscriptionPlan         @relation(fields: [planId], references: [id])
  vendor    Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
  @@map("vendor_subscriptions")
}

model FeaturedListing {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId        String                   @db.Uuid
  productId       String?                  @db.Uuid
  planId          String?                  @db.Uuid
  placement       FeaturedListingPlacement @default(MARKETPLACE_HOME)
  startDate       DateTime?                @db.Timestamptz(6)
  endDate         DateTime?                @db.Timestamptz(6)
  pricePaid       Decimal?                 @db.Decimal(10, 2)
  discountPercent Int                      @default(0)
  imageUrl        String?
  status          FeaturedListingStatus    @default(PENDING)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  product         Product?                 @relation(fields: [productId], references: [id])
  vendor          Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan            FeaturedListingPlan?     @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments        Payment[]

  @@index([vendorId])
  @@index([productId])
  @@index([placement, status, endDate])
  @@map("featured_listings")
}

enum DealDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DealTriggerType {
  NONE
  MIN_QUANTITY
  MIN_ORDER_AMOUNT
}

model Deal {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId      String           @db.Uuid
  productId     String           @db.Uuid
  discountType  DealDiscountType
  discountValue Decimal          @db.Decimal(10, 2)
  triggerType   DealTriggerType  @default(NONE)
  triggerValue  Decimal?         @db.Decimal(10, 2)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  vendor        Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([productId])
  @@index([isActive])
  @@map("deals")
}

model FeaturedListingPlan {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String                   @unique
  placement    FeaturedListingPlacement
  price        Decimal                  @db.Decimal(10, 2)
  durationDays Int
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(6)
  listings     FeaturedListing[]

  @@index([placement, isActive])
  @@map("featured_listing_plans")
}

model Notification {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @db.Uuid
  type              String
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model AuditRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  actionType  String
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_records")
}

